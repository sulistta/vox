import { Button, TextEdit } from "std-widgets.slint";

export component AgentDock inherits Window {
    title: "vocs";
    no-frame: true;
    background: transparent;
    preferred-width: 420px;
    preferred-height: composer-open ? 160px : confirmation-open ? 142px : 56px;
    min-width: 420px;
    max-width: 420px;
    min-height: 56px;
    max-height: 160px;

    in property <bool> composer-open: false;
    in property <string> status-text: "Ready";
    in property <bool> working: false;
    in-out property <string> composer-text: "";
    in-out property <bool> confirmation-open: false;
    in-out property <string> confirmation-text: "";
    callback submit(string);
    callback close-composer();
    callback chat();
    callback voice();
    callback settings();
    callback allow-once();
    callback cancel-confirmation();
    callback cancel-task();

    Rectangle {
        background: transparent;
        animate preferred-height { duration: 300ms; easing: ease-out; }

        WindowMoveArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            Rectangle {
                background: #0a0a0a;
                border-radius: 16px;
                clip: true;

                if composer-open: Rectangle {
                    x: 0; y: 0; width: parent.width; height: 120px;
                    background: #0a0a0a;
                    TextEdit {
                        x: 8px; y: 8px; width: parent.width - 44px; height: 108px;
                        text <=> composer-text;
                        placeholder-text: "Type something here...";
                        font-size: 14px;
                        wrap: word-wrap;
                        key-pressed(event) => {
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                submit(self.text);
                                return accept;
                            }
                            return reject;
                        }
                    }
                    Button {
                        x: parent.width - 32px; y: 5px; width: 24px; height: 24px;
                        text: "×";
                        clicked => { close-composer(); }
                    }
                }

                if confirmation-open: Rectangle {
                    x: 8px; y: 4px; width: parent.width - 16px; height: 76px;
                    background: #1f1f1f; border-radius: 10px;
                    Text { x: 8px; y: 6px; width: parent.width - 16px; height: 34px; text: confirmation-text; color: white; wrap: word-wrap; }
                    Button { x: 8px; y: 43px; width: 85px; height: 26px; text: "Cancel"; clicked => { cancel-confirmation(); } }
                    Button { x: 100px; y: 43px; width: 100px; height: 26px; text: "Allow once"; clicked => { allow-once(); } }
                }

                HorizontalLayout {
                    y: composer-open ? 120px : confirmation-open ? 82px : 0px;
                    height: 40px;
                    spacing: 12px;
                    Rectangle {
                        width: 36px; height: 36px; border-radius: 12px;
                        background: #292929;
                        Text { text: "V"; color: white; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { settings(); } }
                    }
                    VerticalLayout {
                        min-width: 0px;
                        Text { text: "vocs"; color: white; font-size: 14px; font-weight: 600; }
                        Text { text: status-text; color: #a3a3a3; font-size: 12px; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        Button { text: "♩  Voice  V"; clicked => { voice(); } }
                        Button {
                            text: composer-open ? "➤  Send  C" : "☵  Chat  C";
                            clicked => {
                                if (composer-open) { submit(composer-text); } else { chat(); }
                            }
                        }
                        if working: Button { text: "Cancel"; clicked => { cancel-task(); } }
                    }
                }
            }
        }
    }

}

export component SettingsWindow inherits Window {
    title: "Vocs Settings";
    preferred-width: 520px;
    preferred-height: 500px;
    in-out property <string> jev-base-url: "https://api.typesafe.ai";
    in-out property <string> jev-model: "jev-latest";
    in-out property <string> jev-api-key: "";
    in-out property <string> text-base-url: "";
    in-out property <string> text-model: "";
    in-out property <string> text-api-key: "";
    in-out property <string> status-text: "Not configured";
    callback save();
    callback test-jev();
    callback test-text();
    VerticalLayout {
        padding: 20px; spacing: 8px;
        Text { text: "Settings"; font-size: 22px; }
        Text { text: "Decision Engine — TypeSafe Jev"; font-size: 16px; }
        TextEdit { text <=> jev-base-url; placeholder-text: "Jev base URL"; }
        TextEdit { text <=> jev-model; placeholder-text: "Jev model"; }
        TextEdit { text <=> jev-api-key; placeholder-text: "API key (leave blank to keep saved key)"; }
        Button { text: "Test Jev connection"; clicked => { test-jev(); } }
        Text { text: "Text Provider — Custom OpenAI-compatible"; font-size: 16px; }
        TextEdit { text <=> text-base-url; placeholder-text: "Base URL"; }
        TextEdit { text <=> text-model; placeholder-text: "Model"; }
        TextEdit { text <=> text-api-key; placeholder-text: "API key (optional; leave blank to keep saved key)"; }
        Button { text: "Test text provider"; clicked => { test-text(); } }
        HorizontalLayout {
            Button { text: "Save"; clicked => { save(); } }
            Text { text: status-text; color: #666; }
        }
    }
}
