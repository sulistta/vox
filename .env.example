# Both services are required for an operational Vox run. Never commit real keys.
VOX_TEXT_BASE_URL=http://127.0.0.1:11434/v1
VOX_TEXT_MODEL=local-model
VOX_TEXT_API_KEY=
VOX_TEXT_ACCOUNT=your-text-keyring-account

VOX_AGENT_MODEL=jev-latest
VOX_AGENT_API_KEY=
# VOX_AGENT_BASE_URL=https://api.typesafe.ai/v1/systemone
VOX_AGENT_ACCOUNT=your-jev-keyring-account

# Optional isolated location for the SQLite data file.
# VOX_DATA_DIR=/tmp/vox-data
