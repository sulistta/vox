# Safe default: deterministic local text provider.
VOX_PROVIDER=fake

# Optional OpenAI-compatible endpoint. Never commit a real key.
# VOX_PROVIDER=openai-compatible
# VOX_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
# VOX_PROVIDER_MODEL=local-model
# Optional: resolve the key from the native OS keyring instead of putting it
# in this environment. The account is an identifier, not the secret itself.
# VOX_PROVIDER_ACCOUNT=your-keyring-account
# VOX_PROVIDER_API_KEY=

# Optional isolated location for the SQLite data file.
# VOX_DATA_DIR=/tmp/vox-data
